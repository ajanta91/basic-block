{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "basic-block/button",
  "version": "1.0.0",
  "title": "Button [BB]",
  "category": "wp-nonce-blocks",  
  "description": "Display a Button block.",
  "example": {},
  "attributes": {
    "buttonLabel": {
      "type": "string",
      "default": "Click Me"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "buttonClass": {
      "type": "string",
      "default": "btn-primary"
    },
    "padding": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "fontFamily": {
      "type": "string"
    },
    "fontSize": {
      "type": "number"
    },
    "fontSizeUnit": {
      "type": "string",
      "default": "px"
    },
    "fontWeight": {
      "type": "string"
    },
    "transform": {
      "type": "string"
    },
    "fontStyle": {
      "type": "string"
    },
    "textDecoration": {
      "type": "string"
    },
    "buttonId": {
      "type": "string",
      "default": ""
    },
    "textColor": {
      "type": "string"
    },
    "btnBackground": {
      "type": "string"
    },
    "customClass": {
      "type": "string",
      "default": ""
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "borderWidth": {
      "type": "number"
    },
    "borderWidthUnit": {
      "type": "string",
      "default": "px"
    },
    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "number"
    },
    "borderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "boxShadowHorizontal": {
      "type": "number",
      "default": 0
    },
    "boxShadowVertical": {
      "type": "number",
      "default": 0
    },
    "boxShadowBlur": {
      "type": "number",
      "default": 0
    },
    "boxShadowSpread": {
      "type": "number",
      "default": 0
    },
    "boxShadowColor": {
      "type": "string"
    },
    "boxShadowInset": {
      "type": "boolean",
      "default": false
    },
    "bgType": {
      "type": "string",
      "default": "color"
    },
    "bgColor": {
      "type": "string"
    },
    "bgGradientType": {
      "type": "string",
      "default": "linear"
    },
    "bgGradientAngle": {
      "type": "number",
      "default": 180
    },
    "bgGradientStops": {
      "type": "array",
      "default": [
        { "color": "#000000", "position": 0 },
        { "color": "#ffffff", "position": 100 }
      ]
    },
    "bgImage": {
      "type": "string"
    },
    "bgImageId": {
      "type": "number"
    },
    "bgImageSize": {
      "type": "string",
      "default": "cover"
    },
    "bgImagePosition": {
      "type": "string",
      "default": "center center"
    },
    "bgImageRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "bgImageAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "bgImageBlendMode": {
      "type": "string",
      "default": "normal"
    },
    "bgParallax": {
      "type": "boolean",
      "default": false
    },
    "bgVideoUrl": {
      "type": "string"
    },
    "bgVideoPoster": {
      "type": "string"
    },
    "bgVideoLoop": {
      "type": "boolean",
      "default": true
    },
    "bgVideoMuted": {
      "type": "boolean",
      "default": true
    },
    "bgPatternImage": {
      "type": "string"
    },
    "bgPatternOpacity": {
      "type": "number",
      "default": 100
    },
    "bgPatternSize": {
      "type": "string",
      "default": "auto"
    },
    "bgPatternBlendMode": {
      "type": "string",
      "default": "normal"
    },
    "bgOverlayColor": {
      "type": "string"
    }
  },
  "supports": {

    "html": false
  
  },
  "textdomain": "basic-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
  
}