{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "basic-block/button",
  "version": "1.0.0",
  "title": "Button [BB]",
  "category": "wp-nonce-blocks",  
  "description": "Display a Button block.",
  "example": {},
  "attributes": {
    "buttonLabel": {
      "type": "string",
      "default": "Click Me"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "buttonClass": {
      "type": "string",
      "default": "btn-primary"
    },
    "padding": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "fontFamily": {
      "type": "string"
    },
    "fontSize": {
      "type": "number"
    },
    "fontSizeUnit": {
      "type": "string",
      "default": "px"
    },
    "fontWeight": {
      "type": "string"
    },
    "transform": {
      "type": "string"
    },
    "fontStyle": {
      "type": "string"
    },
    "textDecoration": {
      "type": "string"
    },
    "buttonId": {
      "type": "string",
      "default": ""
    },
    "textColor": {
      "type": "string"
    },
    "btnBackground": {
      "type": "string"
    },
    "customClass": {
      "type": "string",
      "default": ""
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "borderWidth": {
      "type": "number"
    },
    "borderWidthUnit": {
      "type": "string",
      "default": "px"
    },
    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "number"
    },
    "borderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "boxShadowHorizontal": {
      "type": "number",
      "default": 0
    },
    "boxShadowVertical": {
      "type": "number",
      "default": 0
    },
    "boxShadowBlur": {
      "type": "number",
      "default": 0
    },
    "boxShadowSpread": {
      "type": "number",
      "default": 0
    },
    "boxShadowColor": {
      "type": "string"
    },
    "boxShadowInset": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {

    "html": false
  
  },
  "textdomain": "basic-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
  
}