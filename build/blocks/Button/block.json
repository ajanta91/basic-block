{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "basic-block/button",
  "version": "1.0.0",
  "title": "Button [BB]",
  "category": "wp-nonce-blocks",
  "description": "Display a Button block.",
  "example": {},
  "attributes": {
    "buttonLabel": {
      "type": "string",
      "default": "Click Me"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "buttonClass": {
      "type": "string",
      "default": "btn-primary"
    },
    "padding": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "fontFamily_": {
      "type": "string",
      "default": ""
    },
    "fontSize_": {
      "type": "string",
      "default": ""
    },
    "fontWeight": {
      "type": "string",
      "default": ""
    },
    "transform": {
      "type": "string",
      "default": ""
    },
    "fontStyle": {
      "type": "string",
      "default": ""
    },
    "textDecoration": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "color": false,
    "html": false,
    "typography": false
  },
  "textdomain": "basic-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}